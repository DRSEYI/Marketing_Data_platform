unified_mkt_platform:
  target: prod

  outputs:
    prod:
      type: databricks
      catalog: marketing_prod
      schema: elementary

      host: "{{ env_var('PROD_DATABRICKS_HOST') }}"
      http_path: "{{ env_var('PROD_DATABRICKS_HTTP_PATH') }}"

      auth_type: oauth
      client_id: "{{ env_var('PROD_DATABRICKS_CLIENT_ID') }}"
      client_secret: "{{ env_var('DBT_ENV_SECRET_PROD_DATABRICKS_CLIENT_SECRET') }}"

      threads: 4